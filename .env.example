# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# CORS Configuration (comma-separated or single origin)
CORS_ORIGIN=http://localhost:5173

# Executable Paths (Optional if installed globally in PATH)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Temporary Storage Paths
# TEMP_DIR=/tmp/mediaflow-jobs
# UPLOAD_DIR=/tmp/mediaflow-uploads

# Concurrency & Limits
MAX_CONCURRENT_JOBS=3
MAX_FILE_SIZE_BYTES=524288000
JOB_TIMEOUT_MS=600000
